---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";

const layers = [
  {
    layer: "Layer 1: The Base Layer",
    purpose: "Moisture Management",
    materials: "Merino wool or synthetic (avoid cotton)",
    notes: "Sits directly against the skin. Its job is to wick sweat away so kids don't get chilled when they stop running. Cotton traps sweat and makes kids cold—wool and synthetics stay warm even when damp."
  },
  {
    layer: "Layer 2: The Mid Layer",
    purpose: "Insulation & Warmth",
    materials: "Microfleece, grid fleece, or lightweight wool",
    notes: "Traps warm air generated by the body. For active forest school days, a breathable fleece is better than a bulky sweater. (You can also swap this for a <a href='/gear-explained/down-vs-synthetic' class='text-accent hover:underline'>puffer or synthetic jacket</a> on sub-zero days)."
  },
  {
    layer: "Layer 3: The Outer Shell",
    purpose: "Weather Protection",
    materials: "Waterproof hardshell or windproof softshell",
    notes: "Blocks wind chill and rain. For downpours, use a <a href='/gear-explained/waterproof-ratings-explained' class='text-accent hover:underline'>truly waterproof shell with taped seams</a>; for dry, windy days, use a <a href='/gear-explained/softshells-explained' class='text-accent hover:underline'>stretchy softshell</a>."
  }
];

const weatherScenarios = [
  {
    weather: "Chilly & Dry Autumn Wind",
    setup: "Synthetic base + Microfleece mid layer + Softshell outer",
    why: "Maximizes breathability and movement while cutting biting wind chill without overheating."
  },
  {
    weather: "Pouring Rain & Muddy Puddles",
    setup: "Merino base + Fleece mid layer + 10,000mm Waterproof hardshell suit",
    why: "Locks out water while base layers manage internal sweat during active puddle jumping."
  },
  {
    weather: "Freezing Sub-Zero Winter Day",
    setup: "Thermal merino base + Fleece mid layer + Down puffer + Waterproof shell (if snowing)",
    why: "Doubled-up insulation traps maximum air, while the outer shell protects down from melting snow."
  }
];
---

<Layout title="Outdoor Layering Systems for Kids: How to Dress Them for Any Weather | Peaks and Puddles">
  <Header />

  <main id="main-content" class="mx-auto max-w-6xl px-4 py-12">
    <div class="mx-auto max-w-4xl">
      <!-- Automated Breadcrumb & Freshness Badge -->
      <div class="mb-6 flex flex-wrap items-center justify-between gap-2">
        <Breadcrumb />
        <span class="bg-muted text-muted-foreground rounded-full px-3 py-1 text-xs font-medium">
          Last checked: November 2026
        </span>
      </div>

      <!-- Article Header -->
      <header class="mb-10">
        <div class="mb-3 flex flex-wrap items-center gap-2">
          <span class="bg-accent/15 text-accent rounded-full px-3 py-1 text-xs font-semibold">
            Gear Explained
          </span>
          <span class="bg-muted text-muted-foreground rounded-full px-3 py-1 text-xs font-medium">
            Warmth &amp; Layering
          </span>
        </div>
        <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">
          Outdoor Layering Systems for Kids: The Ultimate Guide to Staying Warm &amp; Dry
        </h1>
        <p class="text-muted-foreground mt-4 text-lg leading-relaxed">
          Ask any parent how to keep kids warm outside, and they will usually say "put a big coat on them." Yet active kids running around a forest school or hill path will sweat through a single heavy jacket in ten minutes—only to freeze the moment they stop moving. The secret isn't one bulky coat; it's the three-tier layering system.
        </p>
      </header>

      <!-- Quick Summary Callout -->
      <div class="bg-card border-accent mb-12 rounded-xl border-l-4 p-6 shadow-sm sm:p-8">
        <h2 class="text-lg font-bold">The Golden Rule of Outdoor Dressing</h2>
        <ul class="text-muted-foreground mt-3 space-y-2 text-sm leading-relaxed">
          <li>
            <strong class="text-foreground">Say goodbye to cotton:</strong> Cotton (like standard character hoodies and t-shirts) absorbs sweat like a sponge, holds moisture against the skin, and makes kids cold.
          </li>
          <li>
            <strong class="text-foreground">Think like an onion:</strong> Multiple thin layers trap more insulating warm air and let you peel clothes off or add them on as weather changes.
          </li>
          <li>
            <strong class="text-foreground">The 3 core tiers:</strong> Base layer (wicks sweat), Mid layer (traps warmth), and Outer layer (blocks wind and rain).
          </li>
        </ul>
      </div>

      <!-- Section 1: The Three Core Layers -->
      <section class="mb-12">
        <h2 class="text-2xl font-bold">1. The 3 Core Layers Explained</h2>
        <p class="text-muted-foreground mt-3 text-sm leading-relaxed">
          Alpine mountaineers have used the three-layer system for decades because it works identically for children playing in a muddy Scottish woodland.
        </p>

        <div class="mt-6 space-y-4">
          {layers.map((item) => (
            <div class="border-border bg-card/50 rounded-xl border p-5">
              <div class="flex flex-wrap items-center justify-between gap-2">
                <h3 class="font-bold">{item.layer}</h3>
                <span class="bg-muted text-muted-foreground rounded-full px-2.5 py-0.5 text-xs font-medium">
                  Goal: {item.purpose}
                </span>
              </div>
              <p class="text-accent mt-1 text-xs font-semibold">
                Recommended fabrics: {item.materials}
              </p>
              <p class="text-muted-foreground mt-2 text-xs leading-relaxed" set:html={item.notes}></p>
            </div>
          ))}
        </div>
      </section>

      <!-- Section 2: Weather Combinations -->
      <section class="mb-12">
        <h2 class="text-2xl font-bold">2. Layering Combinations for Different Weather</h2>
        <p class="text-muted-foreground mt-3 text-sm leading-relaxed">
          You don't need all three layers every single day. Mix and match based on what nature is throwing at you:
        </p>

        <div class="border-border mt-6 overflow-x-auto rounded-xl border">
          <table class="w-full text-left text-sm">
            <thead class="bg-muted/60 border-border border-b text-xs uppercase">
              <tr>
                <th class="px-4 py-3 font-semibold">Weather Condition</th>
                <th class="px-4 py-3 font-semibold">Recommended Setup</th>
                <th class="px-4 py-3 font-semibold">Why It Works</th>
              </tr>
            </thead>
            <tbody class="divide-border divide-y">
              {weatherScenarios.map((row) => (
                <tr>
                  <td class="px-4 py-3 font-medium">{row.weather}</td>
                  <td class="text-accent px-4 py-3 font-semibold">{row.setup}</td>
                  <td class="text-muted-foreground px-4 py-3">{row.why}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <!-- Section 3: Pro Tips for Parents -->
      <section class="mb-12">
        <h2 class="text-2xl font-bold">3. Pro Tips for Temperamental Climates</h2>
        <ul class="text-muted-foreground mt-3 list-disc space-y-2.5 pl-5 text-sm leading-relaxed">
          <li>
            <strong class="text-foreground">Pack a "just in case" mid layer:</strong> Even on mild spring days, weather in the hills can turn instantly. Tucking a lightweight packable fleece or vest into their daypack prevents shivering during snack breaks.
          </li>
          <li>
            <strong class="text-foreground">Check the hands and feet:</strong> Kids lose heat quickly through extremities. Pair a proper layering system with merino socks and waterproof boots so cold toes don't cut adventures short.
          </li>
          <li>
            <strong class="text-foreground">Dress them one layer cooler than you:</strong> Adults generate less body heat when walking slowly, whereas kids run hot while playing. If you feel slightly chilly standing still, your running child is likely comfortable.
          </li>
        </ul>
      </section>

      <!-- Related Guides & Next Steps -->
      <aside class="bg-muted/50 border-border rounded-xl border p-6">
        <h2 class="text-lg font-bold">Continue Exploring Gear Guides</h2>
        <ul class="mt-3 space-y-2 text-sm">
          <li>
            &rarr; Need to choose the right outer shell? Read <a href="/gear-explained/waterproof-ratings-explained" class="text-accent font-medium hover:underline">Waterproof Ratings Explained</a> and <a href="/gear-explained/softshells-explained" class="text-accent font-medium hover:underline">Softshells Explained</a>.
          </li>
          <li>
            &rarr; Deciding on winter insulation? Check our <a href="/gear-explained/down-vs-synthetic" class="text-accent font-medium hover:underline">Down vs. Synthetic Insulation Guide</a>.
          </li>
          <li>
            &rarr; Ready to kit them out? Browse our seasonal recommendations on the <a href="/kit-lists" class="text-accent font-medium hover:underline">Kit Lists Hub</a>.
          </li>
        </ul>
      </aside>
    </div>
  </main>

  <Footer />
</Layout>