---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";

const accessories = [
  {
    category: "The Head & Neck",
    name: "Balaclavas & Neck Buffs over Loose Scarves",
    notes: "Loose scarves are a dangerous snag hazard on woodland climbing frames and ski lifts. A seamless fleece or merino neck buff stays put, while a close-fitting balaclava locks in body heat around the ears and neck without slipping off during tumbles."
  },
  {
    category: "The Hands",
    name: "Long-Gauntlet Waterproof Mittens",
    notes: "Fingered gloves are nearly impossible for young kids to put on frozen fingers, and they chill faster because fingers are separated. Look for waterproof mittens with extra-long gauntlets that tuck securely inside coat sleeves to eliminate the dreaded wrist gap."
  },
  {
    category: "The Feet",
    name: "Merino Wool Socks & Boot Liners",
    notes: "Avoid thick cotton school socks; when damp from sweat or puddles, cotton conducts cold straight to the toes. Merino wool stays warm even when wet, wicks moisture away, and prevents friction blisters on long walks."
  },
  {
    category: "Emergency Morale Boosters",
    name: "Reusable Hand Warmers & Thermal Sit Pads",
    notes: "When core temperatures drop during static snack stops, a snap-activation gel hand warmer inside a mitten or a lightweight folding foam sit pad saves outdoor morale instantly."
  }
];
---

<Layout
  title="Vital Accessories Explained: Hats, Buffs, Mittens & Cold Extremities | Peaks and Puddles"
>
  <Header />

  <main id="main-content" class="mx-auto max-w-6xl px-4 py-12">
    <div class="mx-auto max-w-4xl">
      <!-- Automated Breadcrumb & Freshness Badge -->
      <div class="mb-6 flex flex-wrap items-center justify-between gap-2">
        <Breadcrumb />
        <span
          class="bg-muted text-muted-foreground rounded-full px-3 py-1 text-xs font-medium"
        >
          Last checked: November 2026
        </span>
      </div>

      <!-- Article Header -->
      <header class="mb-10">
        <div class="mb-3 flex flex-wrap items-center gap-2">
          <span
            class="bg-accent/15 text-accent rounded-full px-3 py-1 text-xs font-semibold"
          >
            Gear Explained
          </span>
          <span
            class="bg-muted text-muted-foreground rounded-full px-3 py-1 text-xs font-medium"
          >
            Extremities &amp; Accessories
          </span>
        </div>
        <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">
          Vital Accessories Explained: Why Hats, Buffs &amp; Mittens Make or Break a Walk
        </h1>
        <p class="text-muted-foreground mt-4 text-lg leading-relaxed">
          You can buy a child a 20,000mm mountain-grade shell, but if their fingers
          get cold or a scarf slips off, the walk is over in ten minutes. We break
          down the science of protecting extremities and why small accessories
          determine whether family adventures succeed.
        </p>
      </header>

      <!-- Core Principle Callout -->
      <div
        class="bg-card border-accent mb-12 rounded-xl border-l-4 p-6 shadow-sm sm:p-8"
      >
        <h2 class="text-lg font-bold">The Extremities Rule</h2>
        <p class="text-muted-foreground mt-2 text-sm leading-relaxed">
          The human body naturally prioritizes core organs when exposed to cold,
          restricting blood flow to fingers, toes, and ears first. Because children
          have a higher surface-area-to-mass ratio than adults, their hands and heads
          chill twice as fast. High-performance accessories aren't optional extras—they
          are your primary defense against cold-weather meltdowns.
        </p>
      </div>

      <!-- Accessory Breakdown Grid -->
      <section class="mb-12">
        <h2 class="text-2xl font-bold">The Essential Accessory Breakdown</h2>
        <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2">
          {
            accessories.map((item) => (
              <div class="border-border bg-card/50 rounded-xl border p-5">
                <span class="text-accent text-xs font-semibold tracking-wider uppercase">
                  {item.category}
                </span>
                <h3 class="mt-1 text-lg font-bold">{item.name}</h3>
                <p class="text-muted-foreground mt-2 text-sm leading-relaxed">
                  {item.notes}
                </p>
              </div>
            ))
          }
        </div>
      </section>

      <!-- Why Small Details Matter -->
      <section class="mb-12 space-y-6">
        <h2 class="text-2xl font-bold">Why Design Details Matter for Kids</h2>
        <p class="text-muted-foreground text-sm leading-relaxed">
          When shopping for kids' accessories, standard adult logic doesn't apply.
          Here is what separates gear that sits in a drawer from gear that actually works:
        </p>
        <div class="border-border rounded-xl border p-5">
          <h3 class="font-semibold">The Gauntlet Mitten Advantage</h3>
          <p class="text-muted-foreground mt-2 text-sm leading-relaxed">
            Short gloves leave a 1-inch strip of bare wrist exposed the moment a child reaches up or grabs a branch. Long-gauntlet mittens pull high up past the coat cuff, sealing out snow and wind entirely.
          </p>
        </div>
        <div class="border-border rounded-xl border p-5">
          <h3 class="font-semibold">Buffs Over Scarves</h3>
          <p class="text-muted-foreground mt-2 text-sm leading-relaxed">
            Scarves unwrap, trail in mud, and present genuine safety hazards around play equipment. A stretchy tubular neck buff stays securely in place and can be pulled up over the nose and ears when bitter winds pick up.
          </p>
        </div>
      </section>

      <!-- Internal Cross-Links -->
      <aside class="bg-muted/50 border-border rounded-xl border p-6">
        <h2 class="text-lg font-bold">Related Kit &amp; Guides</h2>
        <ul class="mt-3 space-y-2 text-sm">
          <li>
            &rarr; See how accessories fit into our complete packing guide:{" "}
            <a
              href="/kit-lists/cold-weather-hiking"
              class="text-accent font-medium hover:underline"
            >
              Winter &amp; Cold-Weather Hiking Kit List
            </a>
            .
          </li>
          <li>
            &rarr; Learn how layering protects your core temperature:{" "}
            <a
              href="/gear-explained/layering-systems"
              class="text-accent font-medium hover:underline"
            >
              Outdoor Layering Systems for Kids
            </a>
            .
          </li>
        </ul>
      </aside>
    </div>
  </main>

  <Footer />
</Layout>