---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";

const hhRatings = [
  {
    rating: "1,500mm - 3,000mm",
    label: "Showerproof / Water-Resistant",
    verdict: "School runs & light drizzle",
    notes: "Fine for a quick dash to the car or brief showers, but prolonged rain or sitting on damp grass will push water straight through the fabric."
  },
  {
    rating: "5,000mm - 8,000mm",
    label: "Everyday Waterproof",
    verdict: "Wet walks & muddy playgrounds",
    notes: "The sweet spot for reliable daily kids' waterproofs. Handles steady rain and active play without soaking through."
  },
  {
    rating: "10,000mm - 15,000mm",
    label: "Heavy-Duty Waterproof",
    verdict: "Forest school & hillwalking",
    notes: "Built for all-day exposure in driving rain, kneeling in wet mud, and wearing under backpack straps without pressure leaks."
  },
  {
    rating: "20,000mm+",
    label: "Mountain / Expedition Grade",
    verdict: "Extreme Scottish/Nordic weather",
    notes: "Technical alpine shells designed for sideways rain, wet snow, and sustained storms. Overkill for the playground, essential for high peaks."
  }
];

const shellComparison = [
  {
    feature: "Primary Job",
    hardshell: "Blocks 100% of wind and sustained rain.",
    softshell: "Blocks wind and light drizzle while maximizing stretch and breathability."
  },
  {
    feature: "Hydrostatic Head",
    hardshell: "5,000mm to 20,000mm+ with taped seams.",
    softshell: "Usually unrated or <3,000mm (relies on DWR, not a waterproof membrane)."
  },
  {
    feature: "Breathability & Comfort",
    hardshell: "Can feel crinkly or clammy when kids run hard.",
    softshell: "Quiet, stretchy, and fleece-backed—feels like a cozy hoodie."
  },
  {
    feature: "Best Used For",
    hardshell: "Pouring rain, puddle jumping, and windy summits.",
    softshell: "Dry, chilly days, scrambling, cycling, and high-energy hikes."
  }
];
---

<Layout title="Waterproof Ratings Explained: Hydrostatic Head, DWR & Taped Seams | Peaks and Puddles">
  <Header />

  <main id="main-content" class="mx-auto max-w-6xl px-4 py-12">
    <div class="mx-auto max-w-4xl">
      <!-- Automated 3-Tier Breadcrumb & Freshness Badge -->
      <div class="mb-6 flex flex-wrap items-center justify-between gap-2">
        <Breadcrumb />
        <span class="bg-muted text-muted-foreground rounded-full px-3 py-1 text-xs font-medium">
          Last checked: November 2026
        </span>
      </div>

      <!-- Article Header -->
      <header class="mb-10">
        <div class="mb-3 flex flex-wrap items-center gap-2">
          <span class="bg-accent/15 text-accent rounded-full px-3 py-1 text-xs font-semibold">
            Gear Explained
          </span>
          <span class="bg-muted text-muted-foreground rounded-full px-3 py-1 text-xs font-medium">
            Buying Guide
          </span>
        </div>
        <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">
          Waterproof Ratings Explained: Hydrostatic Head, DWR &amp; What "Waterproof" Actually Means
        </h1>
        <p class="text-muted-foreground mt-4 text-lg leading-relaxed">
          Shopping for kids' rain gear can feel like decoding an engineering manual. Terms like "10,000mm hydrostatic head," "DWR coating," and "taped seams" are printed on every swing tag—yet plenty of "waterproof" jackets still soak through in twenty minutes. Here is what those numbers actually mean in real-world mud and rain.
        </p>
      </header>

      <!-- Quick Summary Callout -->
      <div class="bg-card border-accent mb-12 rounded-xl border-l-4 p-6 shadow-sm sm:p-8">
        <h2 class="text-lg font-bold">The Cheat Sheet for Busy Parents</h2>
        <ul class="text-muted-foreground mt-3 space-y-2 text-sm leading-relaxed">
          <li>
            <strong class="text-foreground">Minimum for real rain:</strong> Look for at least <strong class="text-foreground">5,000mm</strong> (or <strong class="text-foreground">10,000mm+</strong> for forest school and hillwalking).
          </li>
          <li>
            <strong class="text-foreground">Check the seams:</strong> A high waterproof rating means nothing if water leaks through the stitching—always verify <strong class="text-foreground">fully taped or welded seams</strong>.
          </li>
          <li>
            <strong class="text-foreground">Why old coats "wet out":</strong> Usually, the membrane isn't broken—the outer <strong class="text-foreground">DWR water-repellent finish</strong> just needs washing and reproofing.
          </li>
        </ul>
      </div>

      <!-- Section 1: What is Hydrostatic Head? -->
      <section class="mb-12">
        <h2 class="text-2xl font-bold">1. What Is Hydrostatic Head (HH)?</h2>
        <p class="text-muted-foreground mt-3 text-sm leading-relaxed">
          <strong class="text-foreground">Hydrostatic head</strong> is the standard laboratory measurement of how waterproof a fabric is, measured in millimeters (mm).
        </p>
        <p class="text-muted-foreground mt-3 text-sm leading-relaxed">
          To test it, technicians clamp a piece of fabric tightly under a tall, narrow cylinder and slowly fill the tube with water. The height (in millimeters) the water column reaches before droplets begin forcing their way through the weave is the fabric's hydrostatic head rating.
        </p>
        <p class="text-muted-foreground mt-3 text-sm leading-relaxed">
          <strong class="text-foreground">Why higher numbers matter for kids:</strong> Standing still in light rain doesn't exert much pressure. However, the moment a child kneels in wet grass, sits on a damp log, or wears a heavy backpack, that physical pressure pushes water into the fabric—requiring a much higher rating to stay dry.
        </p>

        <!-- Rating Breakdown Grid -->
        <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2">
          {hhRatings.map((item) => (
            <div class="border-border bg-card/50 rounded-xl border p-5">
              <div class="flex items-center justify-between gap-2">
                <span class="text-accent text-sm font-bold">{item.rating}</span>
                <span class="bg-muted text-muted-foreground rounded-full px-2.5 py-0.5 text-xs font-medium">
                  {item.verdict}
                </span>
              </div>
              <h3 class="mt-2 font-bold">{item.label}</h3>
              <p class="text-muted-foreground mt-2 text-xs leading-relaxed">
                {item.notes}
              </p>
            </div>
          ))}
        </div>
      </section>

      <!-- Section 2: Waterproof vs Water-Resistant vs Taped Seams -->
      <section class="mb-12">
        <h2 class="text-2xl font-bold">2. "Waterproof" vs. "Water-Resistant" &amp; Why Seams Matter</h2>
        <div class="mt-4 space-y-4 text-sm leading-relaxed">
          <div class="border-border rounded-xl border p-5">
            <h3 class="font-bold">Water-Resistant / Showerproof</h3>
            <p class="text-muted-foreground mt-1.5">
              Tightly woven fabric treated with a surface repellent, lacking an internal waterproof membrane. It handles mist or brief drizzle, but sustained rain will eventually soak right through.
            </p>
          </div>
          <div class="border-border rounded-xl border p-5">
            <h3 class="font-bold">Truly Waterproof (Membrane + Taped Seams)</h3>
            <p class="text-muted-foreground mt-1.5">
              Combines a solid waterproof barrier (like Gore-Tex, brand-specific PU membranes, or rubberized Galon®) with <strong class="text-foreground">taped or welded seams</strong>. Every time a needle stitches a jacket together, it punches thousands of microscopic holes. Unless those seams are heat-sealed with waterproof tape on the inside, rain will seep straight through the shoulders and hood.
            </p>
          </div>
        </div>
      </section>

      <!-- Section 3: What is DWR? -->
      <section class="mb-12">
        <h2 class="text-2xl font-bold">3. What Is DWR (And Why Do Jackets "Wet Out")?</h2>
        <p class="text-muted-foreground mt-3 text-sm leading-relaxed">
          <strong class="text-foreground">DWR</strong> stands for <strong class="text-foreground">Durable Water Repellent</strong>. It is an invisible chemical coating applied to the <em>outside</em> face fabric of a jacket. DWR is what makes rainwater bead up into tight droplets and roll right off the coat.
        </p>
        <p class="text-muted-foreground mt-3 text-sm leading-relaxed">
          Over time, mud, body oils, and standard laundry detergent wear down the DWR coating. When that happens, the outer fabric absorbs water and turns dark and heavy—a process known as <strong class="text-foreground">"wetting out."</strong> Even if the inner waterproof membrane stops the rain from touching your child's jumper, a wetted-out jacket stops breathing, trapping sweat inside and making them feel cold and damp.
        </p>
        <p class="text-muted-foreground mt-3 text-sm leading-relaxed">
          <em>Good news:</em> You rarely need to replace a jacket that wets out. Washing it with technical cleaner and reapplying a wash-in or spray-on treatment restores the beading action—follow our step-by-step <a href="/gear-explained/gear-care/reproofing-waterproofs" class="text-accent font-medium hover:underline">How to Wash &amp; Reproof Waterproofs</a> guide.
        </p>
      </section>

      <!-- Section 4: Hardshell vs Softshell Comparison -->
      <section class="mb-12">
        <h2 class="text-2xl font-bold">4. Hardshell Waterproofs vs. Softshells: Which Do You Need?</h2>
        <p class="text-muted-foreground mt-3 text-sm leading-relaxed">
          One of the biggest points of confusion when buying kids' outdoor gear is choosing between a traditional waterproof <strong class="text-foreground">hardshell</strong> and a stretchy <strong class="text-foreground">softshell</strong>. While softshells repel light drizzle, they are built for movement and wind protection rather than downpours.
        </p>

        <div class="border-border mt-6 overflow-x-auto rounded-xl border">
          <table class="w-full text-left text-sm">
            <thead class="bg-muted/60 border-border border-b text-xs uppercase">
              <tr>
                <th class="px-4 py-3 font-semibold">Feature</th>
                <th class="px-4 py-3 font-semibold">Waterproof Hardshell</th>
                <th class="px-4 py-3 font-semibold">Softshell Jacket / Suit</th>
              </tr>
            </thead>
            <tbody class="divide-border divide-y">
              {shellComparison.map((row) => (
                <tr>
                  <td class="px-4 py-3 font-medium">{row.feature}</td>
                  <td class="text-muted-foreground px-4 py-3">{row.hardshell}</td>
                  <td class="text-muted-foreground px-4 py-3">{row.softshell}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <p class="text-muted-foreground mt-4 text-xs">
          Want to know when a fleece-lined softshell beats a rain jacket? Check out our upcoming deep dive: <strong>Softshells Explained: Why Every Outdoor Kid Needs One</strong>.
        </p>
      </section>

      <!-- Related Guides & Next Steps -->
      <aside class="bg-muted/50 border-border rounded-xl border p-6">
        <h2 class="text-lg font-bold">Continue Exploring Gear Guides</h2>
        <ul class="mt-3 space-y-2 text-sm">
          <li>
            &rarr; Keep existing rain gear performing: <a href="/gear-care/reproofing-waterproofs" class="text-accent font-medium hover:underline">How to Wash &amp; Reproof Kids' Waterproofs</a>.
          </li>
          <li>
            &rarr; Looking for 10,000mm+ tested kids' outerwear? Read our <a href="/brands-and-shops/brands/didriksons" class="text-accent font-medium hover:underline">Didriksons Brand Review</a> or <a href="/brands-and-shops/brands/reima" class="text-accent font-medium hover:underline">Reima Brand Review</a>.
          </li>
          <li>
            &rarr; Coming soon in <em>Gear Explained</em>: <strong>Down vs. Synthetic Insulation for Kids</strong> &amp; <strong>The Complete Softshell Guide</strong>.
          </li>
        </ul>
      </aside>
    </div>
  </main>

  <Footer />
</Layout>