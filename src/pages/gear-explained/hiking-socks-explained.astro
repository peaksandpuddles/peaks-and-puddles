---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";

const sockComparison = [
  {
    feature: "Moisture & Sweat Control",
    cotton: "Absorbs sweat like a sponge and stays soggy against skin.",
    merinoBlend: "Wicks moisture away and keeps toes warm even when damp.",
    winner: "Merino Blend"
  },
  {
    feature: "Blister Prevention",
    cotton: "Wet cotton bunches up and creates high skin friction.",
    merinoBlend: "Smooth, elastic fit with cushioned heel/toe zones cuts friction.",
    winner: "Merino Blend"
  },
  {
    feature: "Temperature Regulation",
    cotton: "Freezes cold in winter; gets clammy in summer.",
    merinoBlend: "Naturally insulating in frost yet breathable in warm weather.",
    winner: "Merino Blend"
  },
  {
    feature: "Durability",
    cotton: "Stretches out quickly and wears thin at the heels.",
    merinoBlend: "Nylon reinforcement in high-wear zones lasts for years.",
    winner: "Merino Blend"
  }
];
---

<Layout
  title="Kids' Hiking Socks Explained: Blisters, Cushioning & Why Cotton Fails | Peaks and Puddles"
>
  <Header />

  <main id="main-content" class="mx-auto max-w-6xl px-4 py-12">
    <div class="mx-auto max-w-4xl">
      <!-- Automated Breadcrumb & Freshness Badge -->
      <div class="mb-6 flex flex-wrap items-center justify-between gap-2">
        <Breadcrumb />
        <span
          class="bg-muted text-muted-foreground rounded-full px-3 py-1 text-xs font-medium"
        >
          Last checked: November 2026
        </span>
      </div>

      <!-- Article Header -->
      <header class="mb-10">
        <div class="mb-3 flex flex-wrap items-center gap-2">
          <span
            class="bg-accent/15 text-accent rounded-full px-3 py-1 text-xs font-semibold"
          >
            Gear Explained
          </span>
          <span
            class="bg-muted text-muted-foreground rounded-full px-3 py-1 text-xs font-medium"
          >
            Footwear &amp; Socks
          </span>
        </div>
        <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">
          Kids' Hiking Socks Explained: Why Cotton Blisters &amp; How to Pick
          the Right Pair
        </h1>
        <p class="text-muted-foreground mt-4 text-lg leading-relaxed">
          Parents happily spend £70 on waterproof walking boots—and then put
          their child in £2 cotton school socks. Within an hour on the trail,
          sweaty feet turn cold, fabric bunches under the heel, and blisters
          ruin the walk. Here is why proper socks matter as much as the boots.
        </p>
      </header>

      <!-- Quick Summary Callout -->
      <div
        class="bg-card border-accent mb-12 rounded-xl border-l-4 p-6 shadow-sm sm:p-8"
      >
        <h2 class="text-lg font-bold">The Golden Rules of Kids' Trail Socks</h2>
        <ul class="text-muted-foreground mt-3 space-y-2 text-sm leading-relaxed">
          <li>
            <strong class="text-foreground">Ban cotton on walks:</strong>{" "}
            Cotton traps sweat, swells up when wet, and causes both cold toes
            and friction blisters.
          </li>
          <li>
            <strong class="text-foreground">Look for 50%–70% Merino + Nylon:</strong>{" "}
            Pure 100% wool wears through fast in boots. A merino-nylon-elastane
            blend gives soft warmth plus tough heel durability.
          </li>
          <li>
            <strong class="text-foreground">Never double-sock kids:</strong>{" "}
            Layering two pairs of socks makes them rub against each other,
            squashes toes inside the boot, and restricts blood circulation.
          </li>
        </ul>
      </div>

      <!-- Section 1: Cotton vs Merino Comparison -->
      <section class="mb-12">
        <h2 class="text-2xl font-bold">
          1. Everyday Cotton Socks vs. Technical Hiking Socks
        </h2>
        <div class="border-border mt-6 overflow-x-auto rounded-xl border">
          <table class="w-full text-left text-sm">
            <thead class="bg-muted/60 border-border border-b text-xs uppercase">
              <tr>
                <th class="px-4 py-3 font-semibold">Feature</th>
                <th class="px-4 py-3 font-semibold">Standard Cotton Socks</th>
                <th class="px-4 py-3 font-semibold">Merino Hiking Socks</th>
                <th class="px-4 py-3 font-semibold">Winner</th>
              </tr>
            </thead>
            <tbody class="divide-border divide-y">
              {
                sockComparison.map((row) => (
                  <tr>
                    <td class="px-4 py-3 font-medium">{row.feature}</td>
                    <td class="text-muted-foreground px-4 py-3">
                      {row.cotton}
                    </td>
                    <td class="text-muted-foreground px-4 py-3">
                      {row.merinoBlend}
                    </td>
                    <td class="text-accent px-4 py-3 font-semibold">
                      {row.winner}
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </section>

      <!-- Section 2: Cushioning & Fit -->
      <section class="mb-12">
        <h2 class="text-2xl font-bold">
          2. Understanding Cushioning Levels &amp; Boot Sizing
        </h2>
        <ul class="text-muted-foreground mt-3 list-disc space-y-2.5 pl-5 text-sm leading-relaxed">
          <li>
            <strong class="text-foreground">Lightweight Cushioning:</strong>{" "}
            Thin, breathable knit with light padding only under the ball and
            heel. Best for summer trails, waterproof sneakers, and flexible
            barefoot shoes.
          </li>
          <li>
            <strong class="text-foreground">Midweight Cushioning:</strong>{" "}
            Plush terry-loop padding across the sole and shin. Best for 3-season
            hiking boots, rocky paths, and cold winter wellies.
          </li>
          <li>
            <strong class="text-foreground">Always try boots on with hiking socks:</strong>{" "}
            Thick merino socks take up half a shoe size of volume. If boots are
            too tight, compressed toes lose circulation and freeze fast.
          </li>
        </ul>
      </section>

      <!-- Related Guides -->
      <aside class="bg-muted/50 border-border rounded-xl border p-6">
        <h2 class="text-lg font-bold">Continue Exploring Gear Guides</h2>
        <ul class="mt-3 space-y-2 text-sm">
          <li>
            &rarr; Wondering why boots still get damp inside? Read{" "}
            <a
              href="/gear-explained/waterproof-boots-explained"
              class="text-accent font-medium hover:underline"
            >
              Waterproof Membranes &amp; Why Kids' Boots Leak in Wet Grass
            </a>
            .
          </li>
          <li>
            &rarr; Learn more about wool vs. synthetics in{" "}
            <a
              href="/gear-explained/merino-vs-synthetic"
              class="text-accent font-medium hover:underline"
            >
              Merino Wool vs. Synthetic Base Layers
            </a>
            .
          </li>
        </ul>
      </aside>
    </div>
  </main>

  <Footer />
</Layout>