---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";

const packCategories = [
  {
    category: "Clothing & Weather Protection",
    items: [
      {
        name: "Waterproof Shell Jackets & Overtrousers",
        notes:
          "Even on dry mornings, pack lightweight taped-seam shells (such as Keela or Polarn O. Pyret) for sudden hill showers and windy ridge lunch stops."
      },
      {
        name: "Warm Mid-Layer & Spare Socks",
        notes:
          "A lightweight fleece or packable insulated jacket per person, plus a dry pair of merino socks sealed in a ziplock bag for post-puddle recovery."
      },
      {
        name: "Sun Hats, Buffs & Light Gloves",
        notes:
          "Wide-brimmed sun hats for exposed moorland or coastal paths, alongside a merino neck buff and thin gloves for chilly summit gusts."
      }
    ]
  },
  {
    category: "Sun, Bug & Trail First-Aid Basics",
    items: [
      {
        name: "High-SPF Sunscreen & Lip Balm",
        notes:
          "Stick-format SPF 50 makes quick top-ups on kids' noses and ears easy without getting greasy sunscreen on palms."
      },
      {
        name: "Midge/Insect Repellent & Tick Remover",
        notes:
          "Essential in UK woodland, bracken, and heather from spring through autumn—carry a plastic tick twister card and antiseptic wipes in your top pocket."
      },
      {
        name: "Kid-Focused First-Aid & Field Repair Pouch",
        notes:
          "Blister plasters (Compeed), standard fabric plasters, antihistamine cream/liquid, tweezers, a whistle, and a small strip of Tenacious Tape for quick jacket snags."
      }
    ]
  },
  {
    category: "Trail Snacks & Hydration",
    items: [
      {
        name: "1.5L–2L Water + Kids' Spill-Proof Bottles",
        notes:
          "Carry extra water in your main rucksack to refill kids' smaller bottles, plus an insulated flask of hot chocolate or tea for cold-weather morale."
      },
      {
        name: "High-Energy Trail Snacks & 'Summit Bribes'",
        notes:
          "Flapjacks, oatcakes, dried mango, trail mix, and a stash of jelly sweets or chocolate buttons kept strictly for the final steep push or return leg."
      },
      {
        name: "Compact Picnic Mat & Wet Wipes",
        notes:
          "A pocket-sized waterproof groundsheet keeps bums dry on damp grass and heather, paired with biodegradable wipes and a rubbish bag for sticky hands and wrappers."
      }
    ]
  },
  {
    category: "Navigation & Parent Carry",
    items: [
      {
        name: "Offline Map, Compass & Power Bank",
        notes:
          "Download the route offline (OS Maps or Outdooractive) before losing signal at the trailhead, and pack a small power bank as cold weather drains phone batteries fast."
      },
      {
        name: "Headtorch & Emergency Foil Blanket",
        notes:
          "Lightweight, takes up almost no room in the bottom of a rucksack, and provides essential safety margin if a walk takes longer than planned."
      },
      {
        name: "Kids' Mini Daypack (Optional for Ages 4+)",
        notes:
          "Letting kids carry a tiny pack with their own water bottle, a snack, and a magnifying glass or nature spotter sheet keeps them invested in the walk."
      }
    ]
  }
];

const packingTips = [
  {
    title: "Pack Inside Dry Bags or Color-Coded Pouches",
    notes:
      "Use lightweight dry sacks to separate spare clothes, food, and first-aid items inside your rucksack—if a water bottle leaks or rain soaks the pack, dry layers stay completely protected."
  },
  {
    title: "Keep 'Immediate Access' Items in the Top Lid",
    notes:
      "Sunscreen, midge spray, tissues, and a handful of trail snacks should live in the top zip pocket so you never have to unpack the whole bag on a windy hillside."
  },
  {
    title: "Leave a 'Car Boot Recovery Kit' at the Trailhead",
    notes:
      "Keep a separate bag in the car with clean trainers, spare joggers, a towel, and a thermos—so muddy boots and wet waterproofs stay out of the cabin on the drive home."
  }
];
---

<Layout
  title="Family Day Hike Pack Checklist: Snacks, Sun, Bug & First-Aid Basics | Peaks and Puddles"
>
  <Header />

  <main id="main-content" class="mx-auto max-w-6xl px-4 py-12">
    <div class="mx-auto max-w-4xl">
      <!-- Automated Breadcrumb & Freshness Badge -->
      <div class="mb-6 flex flex-wrap items-center justify-between gap-2">
        <Breadcrumb />
        <span
          class="bg-muted text-muted-foreground rounded-full px-3 py-1 text-xs font-medium"
        >
          Last checked: November 2026
        </span>
      </div>

      <!-- Article Header -->
      <header class="mb-10">
        <div class="mb-3 flex flex-wrap items-center gap-2">
          <span
            class="bg-accent/15 text-accent rounded-full px-3 py-1 text-xs font-semibold"
          >
            Kit List
          </span>
          <span
            class="bg-muted text-muted-foreground rounded-full px-3 py-1 text-xs font-medium"
          >
            Full-Day Trail Packing
          </span>
        </div>
        <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">
          Family Day Hike Pack Checklist: Everything to Carry on the Trail With Kids
        </h1>
        <p class="text-muted-foreground mt-4 text-lg leading-relaxed">
          Packing for a full day on the trail with kids is a balancing act: you
          need enough layers, sun and bug protection, trail snacks, and
          first-aid basics to handle changing weather without carrying a
          back-breaking load. Here is our tested day-pack checklist.
        </p>
      </header>

      <!-- Quick Rule Callout Box -->
      <div
        class="bg-card border-accent mb-12 rounded-xl border-l-4 p-6 shadow-sm sm:p-8"
      >
        <h2 class="text-lg font-bold">The 20-Litre Sweet Spot</h2>
        <p class="text-muted-foreground mt-2 text-sm leading-relaxed">
          For a family of four on a 3-to-6-hour hike, a single 20L–28L adult
          daypack with a rain cover—supplemented by a tiny 5L–8L pack for older
          kids to carry their own water and snacks—holds everything comfortably
          without encouraging overpacking.
        </p>
      </div>

      <!-- Categorized Checklist Sections -->
      <div class="mb-12 space-y-10">
        {
          packCategories.map((group) => (
            <section>
              <h2 class="text-2xl font-bold">{group.category}</h2>
              <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-3">
                {group.items.map((item) => (
                  <div class="border-border bg-card/50 rounded-xl border p-5">
                    <div class="flex items-start gap-2.5">
                      <span class="border-accent text-accent mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded border text-xs font-bold">
                        &#10003;
                      </span>
                      <h3 class="text-base font-bold leading-snug">
                        {item.name}
                      </h3>
                    </div>
                    <p class="text-muted-foreground mt-2.5 text-sm leading-relaxed">
                      {item.notes}
                    </p>
                  </div>
                ))}
              </div>
            </section>
          ))
        }
      </div>

      <!-- Smart Packing Tips -->
      <section class="mb-12">
        <h2 class="text-2xl font-bold">Smart Packing Habits for Parents</h2>
        <div class="mt-6 space-y-4">
          {
            packingTips.map((tip, index) => (
              <div class="border-border rounded-xl border p-5">
                <div class="flex items-center gap-3">
                  <span class="bg-accent text-accent-foreground flex h-7 w-7 shrink-0 items-center justify-center rounded-full text-xs font-bold">
                    {index + 1}
                  </span>
                  <h3 class="font-semibold">{tip.title}</h3>
                </div>
                <p class="text-muted-foreground mt-2.5 text-sm leading-relaxed">
                  {tip.notes}
                </p>
              </div>
            ))
          }
        </div>
      </section>

      <!-- Internal Cross-Links -->
      <aside class="bg-muted/50 border-border rounded-xl border p-6">
        <h2 class="text-lg font-bold">Related Gear Guides &amp; Day Hike Ideas</h2>
        <ul class="mt-3 space-y-2 text-sm">
          <li>
            &rarr; Deep dive into trail fuel and hydration strategies:{" "}
            <a
              href="/gear-explained/snacks-and-hydration"
              class="text-accent font-medium hover:underline"
            >
              Snacks &amp; Hydration Explained
            </a>
            .
          </li>
          <li>
            &rarr; Why tubular neck buffs, hats, and gloves matter on exposed ridges:{" "}
            <a
              href="/gear-explained/vital-accessories-extremities"
              class="text-accent font-medium hover:underline"
            >
              Vital Accessories Explained
            </a>
            .
          </li>
          <li>
            &rarr; Keep a small strip of Tenacious Tape in your first-aid pouch:{" "}
            <a
              href="/gear-care/gear-repair-guide"
              class="text-accent font-medium hover:underline"
            >
              Field Patches &amp; UK Repair Hubs Guide
            </a>
            .
          </li>
          <li>
            &rarr; Put this pack list to use on a classic family hill walk:{" "}
            <a
              href="/adventures/scotland/pentland-hills"
              class="text-accent font-medium hover:underline"
            >
              Pentland Hills Regional Park Guide
            </a>
            .
          </li>
        </ul>
      </aside>
    </div>
  </main>

  <Footer />
</Layout>