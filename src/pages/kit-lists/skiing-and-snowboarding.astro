---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";

const skiKitCategories = [
  {
    category: "Base Layers & Thermal Management",
    items: [
      {
        name: "Merino Wool Thermal Tops & Leggings (180gsm–200gsm)",
        notes:
          "The absolute foundation of cold-weather snow sports. Avoid cotton completely (it holds sweat and freezes against skin); superfine merino (like Isobaa or Icebreaker) naturally regulates temperature on chairlifts and during high-output descents."
      },
      {
        name: "Ski Socks (Over-the-Calf & Seamless)",
        notes:
          "Wear a single pair of specialist merino or synthetic ski socks pulled smooth inside ski boots. Thick socks or double-layering cause bunching, pinch points, and icy toes by blocking blood circulation."
      },
      {
        name: "Fleece Mid-Layer or Lightweight Down Jacket",
        notes:
          "A breathable 200gsm grid fleece or packable down/synthetic sweater to layer under the ski jacket on sub-zero alpine mornings."
      }
    ]
  },
  {
    category: "Outerwear: Waterproof Shells & Insulation",
    items: [
      {
        name: "Waterproof & Windproof Ski Jacket (10,000mm+)",
        notes:
          "Needs a snow powder skirt, taped seams, a helmet-compatible adjustable hood, and a dedicated sleeve pocket for ski lift passes (Epic/Ikon or resort keycards)."
      },
      {
        name: "Ski Trousers / Salopettes with Scuff Guards",
        notes:
          "Bib-style salopettes or high-waisted trousers prevent snow from sliding down children's backs during tumbles, featuring reinforced inner ankles to protect against ski edge slashes."
      },
      {
        name: "Waterproof Mittens Over Gloves (With Wrist Leashes)",
        notes:
          "Mittens are significantly warmer than gloves for young children. Always attach elasticated wrist leashes ('dummy cords') so gloves don't get dropped from chairlifts into deep powder."
      }
    ]
  },
  {
    category: "Head, Eye & Extremity Protection",
    items: [
      {
        name: "Certified Ski/Snowboard Helmet (EN 1077 / ASTM F2040)",
        notes:
          "Mandatory across most European and North American resorts. Ensure a snug dial-fit with no tilt; rental helmets are widely available, but buying your own guarantees fit and hygiene."
      },
      {
        name: "Dual-Lens Ski Goggles (Cat 2 or 3 + Interchangeable Low-Light Lens)",
        notes:
          "Protect eyes from UV glare off snow and biting wind chill. Dual-lens construction stops internal fogging; amber or rose-tinted low-light lenses are essential during whiteouts or heavy snowfall."
      },
      {
        name: "Merino Balaclava or Fleece Neck Buff",
        notes:
          "Sits comfortably under the helmet without bunching around the neck, protecting cheeks and noses on freezing wind-blown chairlifts."
      }
    ]
  },
  {
    category: "On-Mountain Extras & Après-Ski",
    items: [
      {
        name: "High-SPF Sunscreen & Zinc Lip Balm",
        notes:
          "UV radiation increases dramatically at altitude, and reflection off snow burns children's faces fast. Apply waterproof SPF 50 before hitting the nursery slopes."
      },
      {
        name: "Pocket Snacks & Warm Flask/Hydration",
        notes:
          "High-energy flapjacks or chocolate bars kept in chest pockets (body heat keeps them from freezing solid), plus an insulated flask of hot tea or chocolate."
      },
      {
        name: "Snow Boots & Grippy Walking Footwear",
        notes:
          "Ski boots are stiff and clumsy for walking to the lifts or village; pack dedicated winter snow boots with deep rubber treads for walking across icy resort car parks and resort streets."
      }
    ]
  }
];

const resortTips = [
  {
    title: "Label Every Item with Name & Phone Number",
    notes:
      "Ski schools and rental hubs look identical at 3:30 PM. Write contact details clearly inside jackets, helmets, and gloves so lost items find their way back."
    },
  {
    title: "Layer According to Activity, Not Just Air Temperature",
    notes:
      "Kids warm up instantly pushing through ski school snowploughs but freeze immediately sitting still on a windy chairlift. Make sure outer shells are windproof to block chairlift chill."
    },
  {
    title: "Rent Skis & Boots Locally for Growing Kids",
    notes:
      "Unless you ski multiple weeks a year, renting equipment in resort (or via seasonal swap shops) ensures correct DIN safety settings and boot sizing for fast-growing feet."
    }
];
---

<Layout
  title="Family Skiing & Snowboarding Kit List: Thermal Layers, Helmets & Gear | Peaks and Puddles"
>
  <Header />

  <main id="main-content" class="mx-auto max-w-6xl px-4 py-12">
    <div class="mx-auto max-w-4xl">
      <!-- Automated Breadcrumb & Freshness Badge -->
      <div class="mb-6 flex flex-wrap items-center justify-between gap-2">
        <Breadcrumb />
        <span
          class="bg-muted text-muted-foreground rounded-full px-3 py-1 text-xs font-medium"
        >
          Last checked: November 2026
        </span>
      </div>

      <!-- Article Header -->
      <header class="mb-10">
        <div class="mb-3 flex flex-wrap items-center gap-2">
          <span
            class="bg-accent/15 text-accent rounded-full px-3 py-1 text-xs font-semibold"
          >
            Kit List
          </span>
          <span
            class="bg-muted text-muted-foreground rounded-full px-3 py-1 text-xs font-medium"
          >
            Skiing &amp; Snowboarding
          </span>
        </div>
        <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">
          Family Skiing &amp; Snowboarding Kit List: Alpine Layers, Goggles &amp; Safety Essentials
        </h1>
        <p class="text-muted-foreground mt-4 text-lg leading-relaxed">
          Whether heading to indoor snow domes or alpine resorts like Megève,
          keeping kids warm, dry, and comfortable on the slopes makes the
          difference between an amazing family adventure and frozen tears. Here
          is our complete snow sports packing checklist.
        </p>
      </header>

      <!-- Golden Rule Callout Box -->
      <div
        class="bg-card border-accent mb-12 rounded-xl border-l-4 p-6 shadow-sm sm:p-8"
      >
        <h2 class="text-lg font-bold">The No-Cotton Rule in Sub-Zero Temps</h2>
        <p class="text-muted-foreground mt-2 text-sm leading-relaxed">
          Never let kids wear cotton socks or t-shirts skiing. Cotton absorbs
          sweat and holds it against the skin, turning ice-cold on chairlifts.
          Stick exclusively to merino wool or synthetic technical base layers.
        </p>
      </div>

      <!-- Categorized Checklist Sections -->
      <div class="mb-12 space-y-10">
        {
          skiKitCategories.map((group) => (
            <section>
              <h2 class="text-2xl font-bold">{group.category}</h2>
              <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-3">
                {group.items.map((item) => (
                  <div class="border-border bg-card/50 rounded-xl border p-5">
                    <div class="flex items-start gap-2.5">
                      <span class="border-accent text-accent mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded border text-xs font-bold">
                        &#10003;
                      </span>
                      <h3 class="text-base font-bold leading-snug">
                        {item.name}
                      </h3>
                    </div>
                    <p class="text-muted-foreground mt-2.5 text-sm leading-relaxed">
                      {item.notes}
                    </p>
                  </div>
                ))}
              </div>
            </section>
          ))
        }
      </div>

      <!-- Parent Resort Tips -->
      <section class="mb-12">
        <h2 class="text-2xl font-bold">Resort &amp; On-Mountain Parent Habits</h2>
        <div class="mt-6 space-y-4">
          {
            resortTips.map((tip, index) => (
              <div class="border-border rounded-xl border p-5">
                <div class="flex items-center gap-3">
                  <span class="bg-accent text-accent-foreground flex h-7 w-7 shrink-0 items-center justify-center rounded-full text-xs font-bold">
                    {index + 1}
                  </span>
                  <h3 class="font-semibold">{tip.title}</h3>
                </div>
                <p class="text-muted-foreground mt-2.5 text-sm leading-relaxed">
                  {tip.notes}
                </p>
              </div>
            ))
          }
        </div>
      </section>

      <!-- Internal Cross-Links -->
      <aside class="bg-muted/50 border-border rounded-xl border p-6">
        <h2 class="text-lg font-bold">Related Guides &amp; Alpine Adventures</h2>
        <ul class="mt-3 space-y-2 text-sm">
          <li>
            &rarr; Superfine merino base layers and neck tubes:{" "}
            <a
              href="/brands-and-shops/brands/isobaa"
              class="text-accent font-medium hover:underline"
            >
              Isobaa Brand Guide
            </a>
            .
          </li>
          <li>
            &rarr; Why hats, balaclavas, and mitts prevent cold-weather meltdowns:{" "}
            <a
              href="/gear-explained/vital-accessories-extremities"
              class="text-accent font-medium hover:underline"
            >
              Vital Accessories Explained
            </a>
            .
          </li>
          <li>
            &rarr; Put this kit list to use in the French Alps:{" "}
            <a
              href="/adventures/france/megeve-skiing"
              class="text-accent font-medium hover:underline"
            >
              Megève Family Skiing Guide
            </a>
            .
          </li>
          <li>
            &rarr; Scoring discounted ski jackets and thermal layers:{" "}
            <a
              href="/brands-and-shops/shops/sport-pursuit"
              class="text-accent font-medium hover:underline"
            >
              SportPursuit Flash Sales Guide
            </a>
            .
          </li>
        </ul>
      </aside>
    </div>
  </main>

  <Footer />
</Layout>