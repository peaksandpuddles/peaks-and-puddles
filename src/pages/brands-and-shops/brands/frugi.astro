---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";

// Swap "#" for your affiliate link (e.g., Awin / direct brand affiliate program)
const brandAffiliateUrl = "#";

const topLines = [
  {
    category: "Recycled Waterproofs",
    name: "Puddle Buster Coats, Dungarees & All-in-Ones",
    notes:
      "Made from 100% recycled post-consumer plastic bottles with a 10,000mm hydrostatic head rating, fully welded or taped seams, and PFC-free waterproofing—built for puddle jumping and nursery mud kitchens."
  },
  {
    category: "4-in-1 Outerwear",
    name: "Explorer Waterproof Coats with Zip-Out Fleeces",
    notes:
      "Versatile modular jackets pairing a waterproof, breathable outer shell with a reversible, zip-out fleece lining so kids get four seasonal coat combinations in one."
  },
  {
    category: "Everyday Trail & Play Layers",
    name: "GOTS Organic Cotton Hoodies, Leggings & Adventure Trousers",
    notes:
      "Thick, brush-backed organic cotton tops and reinforced-knee adventure joggers that stand up to tree climbing and playground slides (just swap for merino/synthetic thermals on freezing hill days)."
  },
  {
    category: "Rain Footwear & Accessories",
    name: "Natural Rubber Puddle Buster Wellies & Waterproof Mittens",
    notes:
      "Flexible natural rubber wellington boots with grippy cleated soles and pull-on handles, matched with fleece-lined waterproof mittens."
  }
];

const parentTakeaways = [
  {
    title: "Clever 'Grow-With-Me' Fold-Down Cuffs & Waistbands",
    notes:
      "Frugi is famous among UK parents for extra-long rib cuffs on sleeves and ankles that fold up when new and roll down as your child grows—easily adding an extra six months of wear."
  },
  {
    title: "100% Recycled Bottle Outerwear & Organic Cotton",
    notes:
      "Every Frugi waterproof coat and puddle suit is spun from recycled plastic bottles with fluorocarbon-free water repellency, while their jersey layers use soft GOTS-certified organic cotton."
  },
  {
    title: "High-Visibility Bright Prints & Strong Resale Demand",
    notes:
      "Frugi's bold Cornish prints make kids easy to spot in busy woodlands or playgrounds—and sought-after designs hold strong resale value on Vinted and dedicated Frugi pre-loved groups."
  }
];
---

<Layout
  title="Frugi Brand Review for Outdoor Parents: Puddle Suits & Eco Gear | Peaks and Puddles"
>
  <Header />

  <main id="main-content" class="mx-auto max-w-6xl px-4 py-12">
    <div class="mx-auto max-w-4xl">
      <!-- Automated Breadcrumb & Evergreen Freshness Badge -->
      <div class="mb-6 flex flex-wrap items-center justify-between gap-2">
        <Breadcrumb />
        <span
          class="bg-muted text-muted-foreground rounded-full px-3 py-1 text-xs font-medium"
        >
          Last checked: November 2026
        </span>
      </div>

      <!-- Article Header -->
      <header class="mb-10">
        <div class="mb-3 flex flex-wrap items-center gap-2">
          <span
            class="bg-accent/15 text-accent rounded-full px-3 py-1 text-xs font-semibold"
          >
            Eco &amp; Puddle Play
          </span>
          <span
            class="bg-muted text-muted-foreground rounded-full px-3 py-1 text-xs font-medium"
          >
            Cornish Outdoor Gear
          </span>
        </div>
        <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">
          Frugi Brand Review: Are Their Recycled Puddle Suits &amp; Coats Worth It?
        </h1>
        <p class="text-muted-foreground mt-4 text-lg leading-relaxed">
          Born in Cornwall and tested against Atlantic drizzle and muddy farm
          trails, Frugi blends bright, kid-friendly prints with serious eco
          credentials. We look at how their recycled Puddle Buster waterproofs
          and grow-with-me layers hold up for active UK kids.
        </p>
      </header>

      <!-- Affiliate / Brand Intro Callout -->
      <div
        class="bg-card border-accent mb-12 rounded-xl border-l-4 p-6 shadow-sm sm:p-8"
      >
        <h2 class="text-lg font-bold">
          The Verdict: Practical, Eco-Conscious Kit for Everyday Mud &amp; Rain
        </h2>
        <p class="text-muted-foreground mt-2 text-sm leading-relaxed">
          For toddlers, nursery forest-school days, and wet family walks,
          Frugi's <strong>Puddle Buster</strong> outerwear delivers genuine
          10,000mm waterproof protection without harsh PFC chemicals. While
          their organic cotton clothing is best kept for dry play rather than
          sweaty winter hill climbs, their waterproof shells and 4-in-1 coats
          offer brilliant longevity thanks to extendable cuffs and strong
          secondhand resale value.
        </p>
        <div class="mt-5">
          <a
            href={brandAffiliateUrl}
            rel="nofollow sponsored noopener"
            target="_blank"
            class="bg-accent text-accent-foreground inline-block rounded-lg px-6 py-3 text-sm font-semibold transition-opacity hover:opacity-90"
          >
            Explore Frugi Outdoor Collection &rarr;
          </a>
        </div>
        <p class="text-muted-foreground mt-3 text-xs">
          <em>
            Transparency: We may earn a small commission if you purchase through
            our links at no extra cost to you.
          </em>
        </p>
      </div>

      <!-- Key Line Categories -->
      <section class="mb-12">
        <h2 class="text-2xl font-bold">
          Standout Frugi Lines for Outdoor Families
        </h2>
        <p class="text-muted-foreground mt-2 text-sm leading-relaxed">
          Frugi is best known for organic jersey, but their outerwear line is
          built specifically for wet British weather:
        </p>

        <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2">
          {
            topLines.map((item) => (
              <div class="border-border bg-card/50 rounded-xl border p-5">
                <span class="text-accent text-xs font-semibold tracking-wider uppercase">
                  {item.category}
                </span>
                <h3 class="mt-1 text-lg font-bold">{item.name}</h3>
                <p class="text-muted-foreground mt-2 text-sm leading-relaxed">
                  {item.notes}
                </p>
              </div>
            ))
          }
        </div>
      </section>

      <!-- Why Parents Love Frugi -->
      <section class="mb-12">
        <h2 class="text-2xl font-bold">3 Things Parents Appreciate Most</h2>
        <div class="mt-6 space-y-4">
          {
            parentTakeaways.map((takeaway, index) => (
              <div class="border-border rounded-xl border p-5">
                <div class="flex items-center gap-3">
                  <span class="bg-accent text-accent-foreground flex h-7 w-7 shrink-0 items-center justify-center rounded-full text-xs font-bold">
                    {index + 1}
                  </span>
                  <h3 class="font-semibold">{takeaway.title}</h3>
                </div>
                <p class="text-muted-foreground mt-2.5 text-sm leading-relaxed">
                  {takeaway.notes}
                </p>
              </div>
            ))
          }
        </div>
      </section>

      <!-- Sizing & Layering Note -->
      <section class="mb-12">
        <h2 class="text-2xl font-bold">
          Sizing &amp; Layering Tips for UK Parents
        </h2>
        <p class="text-muted-foreground mt-3 text-sm leading-relaxed">
          Frugi uses standard UK dual-age sizing (such as{" "}
          <strong class="text-foreground">3–4 Years</strong> and{" "}
          <strong class="text-foreground">5–6 Years</strong>) with a generous,
          relaxed cut designed around cloth nappies in baby sizes and thick
          jumpers in older kids' sizes. For active winter hikes, pair a Frugi
          Puddle Buster shell with a{" "}
          <a
            href="/gear-explained/merino-vs-synthetic"
            class="text-accent font-medium hover:underline"
          >
            merino or synthetic base layer
          </a>{" "}
          underneath instead of cotton so kids stay warm even if they work up a
          sweat.
        </p>
      </section>

      <!-- Internal Cross-Links -->
      <aside class="bg-muted/50 border-border rounded-xl border p-6">
        <h2 class="text-lg font-bold">Related Brand &amp; Gear Guides</h2>
        <ul class="mt-3 space-y-2 text-sm">
          <li>
            &rarr; Understand what 10,000mm hydrostatic head means in{" "}
            <a
              href="/gear-explained/waterproof-ratings-explained"
              class="text-accent font-medium hover:underline"
            >
              Waterproof Ratings Explained
            </a>
            .
          </li>
          <li>
            &rarr; Keep recycled waterproofs beading water cleanly:{" "}
            <a
              href="/gear-explained/gear-care/reproofing-waterproofs"
              class="text-accent font-medium hover:underline"
            >
              How to Wash &amp; Reproof Kids' Rain Gear
            </a>
            .
          </li>
          <li>
            &rarr; Compare another European technical favorite in our{" "}
            <a
              href="/brands-and-shops/brands/reima"
              class="text-accent font-medium hover:underline"
            >
              Reima Brand Review
            </a>
            .
          </li>
        </ul>
      </aside>
    </div>
  </main>

  <Footer />
</Layout>