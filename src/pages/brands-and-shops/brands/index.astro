---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";

// 1. Define all your brands here in any order
const allBrands = [
  {
    name: "Reima",
    description: "Technical Nordic outerwear built specifically for active kids, forest schools, and unpredictable weather.",
    href: "/brands-and-shops/brands/reima",
    badge: "Nordic Staple",
    isTopPick: true // <-- Flags this to appear in the top 3
  },
  {
    name: "Didriksons",
    description: "Renowned for waterproof dungarees, grow-with-me cuffs, and weather-resistant parkas that handle heavy rain.",
    href: "/brands-and-shops/brands/didriksons",
    badge: "Hand-Me-Down Quality",
    isTopPick: true // <-- Flags this to appear in the top 3
  },
  {
    name: "Spotty Otter",
    description: "Heavy-duty forest school gear designed to withstand real mud, puddle-sliding, and abrasive ground play.",
    href: "/brands-and-shops/brands/spotty-otter",
    badge: "Forest School Favourite",
    isTopPick: true // <-- Flags this to appear in the top 3
  },
  {
    name: "Keela",
    description: "Homegrown performance waterproofs featuring innovative systems designed to conquer horizontal rain.",
    href: "/brands-and-shops/brands/keela",
    badge: "Technical Shells",
    isTopPick: false
  },
  {
    name: "Polarn O. Pyret",
    description: "Famous for classic striped layers, windfleece jackets, and durable technical outerwear built to last.",
    href: "/brands-and-shops/brands/polarn-o-pyret",
    badge: "Layering Experts",
    isTopPick: false
  }
];

// 2. Automatically filter out the top 3 picks for the top section
const topPicks = allBrands.filter((brand) => brand.isTopPick);

// 3. Automatically sort the remaining (or all) brands alphabetically by name (A-Z)
const alphabetizedBrands = [...allBrands].sort((a, b) => a.name.localeCompare(b.name));
---

<Layout title="Trusted Outdoor Brands for Kids | Peaks and Puddles">
  <Header />

  <main id="main-content" class="mx-auto max-w-7xl px-4 py-12">
    <!-- Breadcrumbs -->
    <div class="mb-6 text-sm">
      <nav aria-label="Breadcrumb" class="text-muted-foreground flex items-center gap-2">
        <a href="/brands-and-shops" class="hover:text-accent hover:underline">Brands &amp; Shops</a>
        <span>/</span>
        <span class="text-foreground font-medium">Brands</span>
      </nav>
    </div>

    <!-- Hub Header -->
    <div class="mx-auto mb-12 max-w-3xl text-center">
      <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">
        Outdoor Brands We Trust
      </h1>
      <p class="text-muted-foreground mt-4 text-lg leading-relaxed">
        We test and review technical outdoor brands that specialize in kids' gear—focusing on genuine waterproof ratings, durability, and pieces that survive hand-me-down cycles.
      </p>
    </div>

    <!-- Top Picks / Featured Section (3 Highlights) -->
    <section class="mb-16">
      <h2 class="mb-6 text-2xl font-bold">Editor's Top Brand Picks</h2>
      <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
        {topPicks.map((brand) => (
          <a
            href={brand.href}
            class="group bg-card text-card-foreground border-border relative flex flex-col justify-between overflow-hidden rounded-xl border p-6 shadow-sm transition-all hover:-translate-y-1 hover:shadow-md"
          >
            <div>
              {brand.badge && (
                <span class="bg-accent text-accent-foreground mb-4 inline-block rounded-full px-3 py-1 text-xs font-semibold shadow-sm">
                  {brand.badge}
                </span>
              )}
              <h3 class="text-xl font-semibold group-hover:text-accent">
                {brand.name} &rarr;
              </h3>
              <p class="text-muted-foreground mt-2 text-sm leading-relaxed">
                {brand.description}
              </p>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Complete Alphabetical Directory Section -->
    <section class="mb-12">
      <div class="mb-6 flex items-baseline justify-between">
        <h2 class="text-2xl font-bold">All Brands (A–Z)</h2>
        <span class="text-muted-foreground text-sm">Alphabetical directory</span>
      </div>

      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {alphabetizedBrands.map((brand) => (
          <a
            href={brand.href}
            class="border-border bg-card/50 hover:border-accent group rounded-xl border p-5 transition-all"
          >
            <div class="flex items-start justify-between gap-2">
              <h3 class="font-bold group-hover:text-accent">{brand.name} &rarr;</h3>
              {brand.badge && (
                <span class="bg-muted text-muted-foreground rounded-full px-2 py-0.5 text-xs font-medium">
                  {brand.badge}
                </span>
              )}
            </div>
            <p class="text-muted-foreground mt-2 text-xs leading-relaxed">{brand.description}</p>
          </a>
        ))}
      </div>
    </section>
  </main>

  <Footer />
</Layout>