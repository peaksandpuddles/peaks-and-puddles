---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";

const shops = [
  {
    name: "Decathlon",
    description: "Budget-friendly technical base layers, fleece, and waterproofs that hold up to daily nursery wear.",
    href: "/brands-and-shops/shops/decathlon",
    badge: "Budget-Friendly"
  },
  {
    name: "SportPursuit",
    description: "Members-only flash sales offering 30% to 60% off high-end kids' and adult outdoor gear.",
    href: "/brands-and-shops/shops/sport-pursuit",
    badge: "Flash Sales"
  }
];
---

<Layout title="Trusted Outdoor Retailers & Shops | Peaks and Puddles">
  <Header />

  <main id="main-content" class="mx-auto max-w-7xl px-4 py-12">
    <!-- Breadcrumbs -->
    <div class="mb-6 text-sm">
      <nav aria-label="Breadcrumb" class="text-muted-foreground flex items-center gap-2">
        <a href="/brands-and-shops" class="hover:text-accent hover:underline">Brands &amp; Shops</a>
        <span>/</span>
        <span class="text-foreground font-medium">Shops</span>
      </nav>
    </div>

    <!-- Hub Header -->
    <div class="mx-auto mb-12 max-w-3xl text-center">
      <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">
        Trusted Outdoor Shops &amp; Retailers
      </h1>
      <p class="text-muted-foreground mt-4 text-lg leading-relaxed">
        Where to buy durable kids' outdoor gear—from budget-friendly high-street staples and private flash-sale outlets to specialist forest school stockists.
      </p>
    </div>

    <!-- Shop Cards Grid -->
    <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
      {shops.map((shop) => (
        <a
          href={shop.href}
          class="group bg-card text-card-foreground border-border rounded-xl border p-6 shadow-sm transition-all hover:-translate-y-1 hover:shadow-md"
        >
          <div class="flex items-start justify-between gap-2">
            <h2 class="text-xl font-semibold group-hover:text-accent">
              {shop.name} &rarr;
            </h2>
            <span class="bg-accent/15 text-accent rounded-full px-2.5 py-0.5 text-xs font-semibold">
              {shop.badge}
            </span>
          </div>
          <p class="text-muted-foreground mt-3 text-sm leading-relaxed">
            {shop.description}
          </p>
        </a>
      ))}
    </div>
  </main>

  <Footer />
</Layout>