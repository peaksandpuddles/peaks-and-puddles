---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";

// Affiliate-ready product recommendations (globally available brands, swap "#" for your links)
const recommendedProducts = [
  {
    name: "Nikwax Tech Wash & TX.Direct Twin Pack",
    bestFor: "Unlined Kids' Rain Suits, Shells & Adult Jackets",
    notes: "Cleans mud and snack stains without leaving water-attracting detergent residue, then restores water beading in a second wash cycle. Air-dries easily without a tumble dryer.",
    priceGuide: "$18 – $24 / £14 – £18",
    retailer: "Check Price",
    affiliateUrl: "#"
  },
  {
    name: "Nikwax Tech Wash & TX.Direct Spray-On",
    bestFor: "Fleece-Lined Raincoats, Padded Snowsuits & Mittens",
    notes: "Use spray-on instead of wash-in whenever kids' outerwear has a cosy fleece lining or synthetic insulation so the inside stays soft and breathable.",
    priceGuide: "$16 – $22 / £12 – £16",
    retailer: "Check Price",
    affiliateUrl: "#"
  },
  {
    name: "Grangers Performance Wash + Repel 2-in-1",
    bestFor: "Busy Parents (Single-Cycle Wash & Reproof)",
    notes: "Cleans and waterproofs in one wash cycle to save time and water. Works best when the care label allows a low-heat tumble dry to activate.",
    priceGuide: "$15 – $20 / £12 – £15",
    retailer: "Check Price",
    affiliateUrl: "#"
  }
];
---

<Layout title="How to Wash & Reproof Kids' Rain Gear & Waterproof Jackets | Peaks and Puddles">
  <Header />

  <main id="main-content" class="mx-auto max-w-4xl px-4 py-12">
    <!-- Breadcrumbs & Evergreen Freshness Badge -->
    <div class="mb-6 flex flex-wrap items-center justify-between gap-2 text-sm">
      <nav aria-label="Breadcrumb" class="text-muted-foreground flex items-center gap-2">
        <a href="/gear-care" class="hover:text-accent hover:underline">Gear Care</a>
        <span>/</span>
        <span class="text-foreground font-medium">Reproofing Waterproofs</span>
      </nav>
      <span class="bg-muted text-muted-foreground rounded-full px-3 py-1 text-xs font-medium">
        Last checked: November 2026
      </span>
    </div>

    <!-- Article Header -->
    <header class="mb-10">
      <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">
        How to Wash &amp; Reproof Kids' Rain Gear &amp; Waterproof Jackets
      </h1>
      <p class="text-muted-foreground mt-4 text-lg leading-relaxed">
        Kids' puddle suits, waterproof dungarees, and winter shells take a beating from mud, playground slides, and regular laundry cycles. If rain is soaking into the outer fabric instead of beading up, a quick wash and reproof brings old coats—and hand-me-downs—back to life.
      </p>
    </header>

    <!-- Parent Quick Takeaway Callout -->
    <div class="bg-card border-accent mb-10 rounded-xl border-l-4 p-6 shadow-sm">
      <h2 class="text-base font-bold uppercase tracking-wide">The #1 Mistake That Ruins Kids' Waterproofs</h2>
      <p class="text-muted-foreground mt-2 text-sm leading-relaxed">
        <strong>Never wash rain gear with regular laundry detergent or fabric softener.</strong> Household detergents leave behind invisible residues that attract water, causing jackets and snow bibs to soak through ("wet out") in heavy rain—and making kids cold and clammy inside.
      </p>
    </div>

    <!-- Step-by-Step Instructions -->
    <section class="space-y-8">
      <h2 class="text-2xl font-bold">Step-by-Step: Cleaning &amp; Reproofing Family Outerwear</h2>

      <div class="space-y-6">
        <div class="border-border rounded-xl border p-6">
          <div class="flex items-center gap-3">
            <span class="bg-accent text-accent-foreground flex h-8 w-8 shrink-0 items-center justify-center rounded-full text-sm font-bold">1</span>
            <h3 class="text-lg font-semibold">Empty Pockets, Brush Off Dried Mud &amp; Fasten Velcro</h3>
          </div>
          <p class="text-muted-foreground mt-3 text-sm leading-relaxed">
            Check every pocket for pebbles, acorns, and forgotten tissues. Brush off heavy dried mud with a damp cloth, zip up all zippers, and <strong>close all Velcro cuff tabs</strong> so they don't snag delicate linings in the drum.
          </p>
        </div>

        <div class="border-border rounded-xl border p-6">
          <div class="flex items-center gap-3">
            <span class="bg-accent text-accent-foreground flex h-8 w-8 shrink-0 items-center justify-center rounded-full text-sm font-bold">2</span>
            <h3 class="text-lg font-semibold">Wash with a Technical Cleaner (Up to 2–3 Kids' Items at Once)</h3>
          </div>
          <p class="text-muted-foreground mt-3 text-sm leading-relaxed">
            Wipe out any leftover household detergent from your washing machine drawer. Add <strong>Nikwax Tech Wash</strong> (or Grangers Performance Wash) and run a gentle <strong>30°C / 85°F synthetic cycle</strong>. You can wash 2–3 kids' waterproof pieces together in one load—often, stripping away ground-in dirt is enough to revive water beading on newer coats.
          </p>
        </div>

        <div class="border-border rounded-xl border p-6">
          <div class="flex items-center gap-3">
            <span class="bg-accent text-accent-foreground flex h-8 w-8 shrink-0 items-center justify-center rounded-full text-sm font-bold">3</span>
            <h3 class="text-lg font-semibold">Choose Wash-In vs. Spray-On Reproofer</h3>
          </div>
          <p class="text-muted-foreground mt-3 text-sm leading-relaxed">
            While the gear is still damp, apply your reproofer based on the lining type:
          </p>
          <ul class="text-muted-foreground mt-3 list-disc space-y-2 pl-5 text-sm leading-relaxed">
            <li>
              <strong>Unlined rain shells &amp; puddle pants:</strong> Run a second gentle 30°C / 85°F cycle with <strong>TX.Direct Wash-In</strong>.
            </li>
            <li>
              <strong>Fleece-lined coats, padded snowsuits &amp; mittens:</strong> Hang them up damp and spray <strong>TX.Direct Spray-On</strong> evenly over the outside fabric (paying extra attention to shoulders, knees, and seats), then wipe away drips with a damp cloth.
            </li>
          </ul>
        </div>

        <div class="border-border rounded-xl border p-6">
          <div class="flex items-center gap-3">
            <span class="bg-accent text-accent-foreground flex h-8 w-8 shrink-0 items-center justify-center rounded-full text-sm font-bold">4</span>
            <h3 class="text-lg font-semibold">Dry &amp; Check for Beading</h3>
          </div>
          <p class="text-muted-foreground mt-3 text-sm leading-relaxed">
            Check the inside care label before drying. Nikwax air-dries naturally on a hanger overnight, while Grangers and some older membranes benefit from <strong>20 minutes on a low tumble-dry setting</strong> to heat-set the water repellency. Sprinkle a few drops of water on the shoulders—if they bead up like tiny pearls, you're ready for puddle season.
          </p>
        </div>
      </div>
    </section>

    <!-- Quick Note on PU / Rubberized Rain Gear -->
    <div class="bg-muted/40 border-border mt-10 rounded-xl border p-6">
      <h3 class="text-base font-bold">What About Rubberized (PU) Toddler Rain Suits?</h3>
      <p class="text-muted-foreground mt-2 text-sm leading-relaxed">
        Thick, shiny polyurethane (PU) rain suits (like traditional Scandinavian splash suits) are naturally waterproof on the surface and don't have a breathable membrane to reproof. Simply hose or wipe them down with warm water, hang them to dry away from direct radiators, and save your wash-in reproofer for breathable fabric shells and snow gear.
      </p>
    </div>

    <!-- Affiliate Product Cards -->
    <section class="mt-14">
      <div class="mb-6 flex flex-wrap items-baseline justify-between gap-2">
        <h2 class="text-2xl font-bold">Parent-Approved Reproofing Products</h2>
        <span class="text-muted-foreground text-xs">
          Links may earn a small commission at no extra cost to you.
        </span>
      </div>

      <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
        {recommendedProducts.map((product) => (
          <div class="bg-card border-border flex flex-col justify-between rounded-xl border p-6 shadow-sm">
            <div>
              <span class="text-accent text-xs font-semibold uppercase tracking-wider">
                {product.bestFor}
              </span>
              <h3 class="mt-2 text-lg font-bold leading-snug">{product.name}</h3>
              <p class="text-muted-foreground mt-3 text-sm leading-relaxed">
                {product.notes}
              </p>
            </div>

            <div class="border-border mt-6 border-t pt-4">
              <div class="mb-3 flex items-center justify-between text-sm">
                <span class="text-muted-foreground">Typical Price:</span>
                <span class="font-semibold">{product.priceGuide}</span>
              </div>
              <a
                href={product.affiliateUrl}
                rel="nofollow sponsored noopener"
                target="_blank"
                class="bg-accent text-accent-foreground block w-full rounded-lg px-4 py-2.5 text-center text-sm font-semibold transition-opacity hover:opacity-90"
              >
                {product.retailer} &rarr;
              </a>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Internal Cross-Links to Other Pillars -->
    <aside class="bg-muted/50 border-border mt-14 rounded-xl border p-6">
      <h2 class="text-lg font-bold">Related Guides for Outdoor Families</h2>
      <ul class="mt-3 space-y-2 text-sm">
        <li>
          &rarr; Getting ready for cold, wet trails? See our <a href="/kit-lists/winter-hillwalking" class="text-accent font-medium hover:underline">Winter &amp; Cold-Weather Hiking Kit List for Kids (and Parents)</a>.
        </li>
        <li>
          &rarr; Looking for durable kids' rain gear worth handing down? Browse <a href="/brands-and-shops" class="text-accent font-medium hover:underline">Brands &amp; Shops</a>.
        </li>
      </ul>
    </aside>
  </main>

  <Footer />
</Layout>