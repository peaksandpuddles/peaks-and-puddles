---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";

const adventures = [
  {
    title: "Dalkeith Country Park: Fort Douglas & River Esk",
    region: "Scotland",
    activities: ["Woodland", "Playground"],
    terrain: "Gravel Paths & Riverside Mud",
    description:
      "Fort Douglas adventure playground, buggy-friendly riverside walks, and easy trail exploring in Midlothian.",
    href: "/adventures/scotland/dalkeith-country-park"
  },
  {
    title:
      "Vogrie Country Park: Treetop Trails, Miniature Railway & Woodland Play",
    region: "Scotland",
    activities: ["Woodland", "Playground"],
    terrain: "Woodland Trails, Boardwalks & Open Lawns",
    description:
      "11 miles of woodland walks, the giant adventure play park, a miniature railway, and muddy burn-side trails near Gorebridge.",
    href: "/adventures/scotland/vogrie-country-park"
  },
  {
    title: "Pentland Hills Regional Park: Reservoirs & Ridge Paths",
    region: "Scotland",
    activities: ["Hill Walking"],
    terrain: "Crushed Gravel & Open Moorland",
    description:
      "Flat, buggy-friendly reservoir circuits and sweeping foothill tracks on Edinburgh's doorstep.",
    href: "/adventures/scotland/pentland-hills"
  },
  {
    title: "Robin Hood's Bay: Family Fossil Hunting & Rockpooling Near Whitby",
    region: "England",
    activities: ["Fossil Hunting", "Seaside"],
    terrain: "Rocky Wave-Cut Platforms, Shingle & Steep Village Cobbles",
    description:
      "Scouring Jurassic shale scars for ammonites, devil's toenails, and belemnites on Yorkshire's Dinosaur Coast, plus tide safety tips for families.",
    href: "/adventures/england/robin-hoods-bay-fossil-hunting"
  },
  {
    title: "Megève Family Skiing: Slopes & Village Trails",
    region: "France",
    activities: ["Skiing", "Snowboarding", "Snow"],
    terrain: "Piste Snow & Alpine Slopes",
    description:
      "Gentle nursery slopes, tree-lined beginner runs, and medieval village charm in the French Alps.",
    href: "/adventures/france/megeve-skiing"
  }
];

const regions = ["All", "Scotland", "England", "France"];
const activityOptions = [
  "All",
  "Woodland",
  "Playground",
  "Hill Walking",
  "Fossil Hunting",
  "Skiing",
  "Snowboarding",
  "Snow",
  "Seaside",
];
---

<Layout
  title="Family Adventure Guides: Trails & Parks for Outdoor Kids | Peaks and Puddles"
>
  <Header />

  <main id="main-content" class="mx-auto max-w-6xl px-4 py-12">
    <div class="mx-auto max-w-4xl">
      <!-- Breadcrumb & Freshness Badge -->
      <div class="mb-6 flex flex-wrap items-center justify-between gap-2">
        <Breadcrumb />
        <span
          class="bg-muted text-muted-foreground rounded-full px-3 py-1 text-xs font-medium"
        >
          Updated: November 2026
        </span>
      </div>

      <!-- Page Header -->
      <header class="mb-10">
        <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">
          Family Adventure Guides: Tested Trails &amp; Parks
        </h1>
        <p class="text-muted-foreground mt-4 text-lg leading-relaxed">
          No-nonsense guides to family-friendly walks, woodland playgrounds, and
          hill trails. Filter by country or activity tag to find your next
          outing.
        </p>
      </header>

      <!-- Interactive Filter Bar -->
      <div
        class="bg-card border-border mb-10 space-y-4 rounded-xl border p-5 shadow-sm"
      >
        <!-- Region Filter -->
        <div>
          <span
            class="text-muted-foreground mb-2 block text-xs font-semibold tracking-wider uppercase"
          >
            Filter by Country / Region
          </span>
          <div class="flex flex-wrap gap-2" id="region-filters">
            {
              regions.map((reg) => (
                <button
                  type="button"
                  data-filter-region={reg}
                  class={`filter-btn-region rounded-full px-3.5 py-1.5 text-xs font-semibold transition-colors ${
                    reg === "All"
                      ? "bg-accent text-accent-foreground"
                      : "bg-muted text-muted-foreground hover:bg-muted/80"
                  }`}
                >
                  {reg}
                </button>
              ))
            }
          </div>
        </div>

        <!-- Activity Filter -->
        <div class="border-border border-t pt-4">
          <span
            class="text-muted-foreground mb-2 block text-xs font-semibold tracking-wider uppercase"
          >
            Filter by Activity Type
          </span>
          <div class="flex flex-wrap gap-2" id="activity-filters">
            {
              activityOptions.map((act) => (
                <button
                  type="button"
                  data-filter-activity={act}
                  class={`filter-btn-activity rounded-full px-3.5 py-1.5 text-xs font-semibold transition-colors ${
                    act === "All"
                      ? "bg-accent text-accent-foreground"
                      : "bg-muted text-muted-foreground hover:bg-muted/80"
                  }`}
                >
                  {act}
                </button>
              ))
            }
          </div>
        </div>
      </div>

      <!-- Filtered Adventures Grid -->
      <div id="adventures-grid" class="grid grid-cols-1 gap-6 sm:grid-cols-2">
        {
          adventures.map((spot) => (
            <a
              href={spot.href}
              data-region={spot.region}
              data-activities={spot.activities.join("|")}
              class="adventure-card border-border bg-card hover:border-accent/50 flex flex-col justify-between rounded-xl border p-6 transition-all hover:shadow-md"
            >
              <div>
                <div class="flex flex-wrap items-center gap-1.5">
                  <span class="bg-muted text-foreground rounded-full px-2.5 py-1 text-xs font-semibold">
                    {spot.region}
                  </span>
                  {spot.activities.map((tag) => (
                    <span class="bg-accent/15 text-accent rounded-full px-2.5 py-1 text-xs font-semibold">
                      {tag}
                    </span>
                  ))}
                </div>
                <p class="text-muted-foreground mt-3 text-xs font-medium">
                  {spot.terrain}
                </p>
                <h2 class="mt-2 text-xl font-bold leading-snug">
                  {spot.title}
                </h2>
                <p class="text-muted-foreground mt-3 text-sm leading-relaxed">
                  {spot.description}
                </p>
              </div>
              <div class="text-accent mt-6 text-sm font-semibold">
                Explore Guide &rarr;
              </div>
            </a>
          ))
        }
      </div>

      <!-- Empty State Message (Hidden by default) -->
      <div
        id="no-results"
        class="border-border bg-muted/30 hidden rounded-xl border p-8 text-center"
      >
        <p class="text-base font-semibold">
          No adventures match that exact combination yet.
        </p>
        <p class="text-muted-foreground mt-1 text-sm">
          Try resetting one of the filters above to see more family trails.
        </p>
        <button
          type="button"
          id="reset-filters"
          class="bg-accent text-accent-foreground mt-4 rounded-lg px-4 py-2 text-xs font-semibold hover:opacity-90"
        >
          Reset All Filters
        </button>
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<script>
  let activeRegion = "All";
  let activeActivity = "All";

  const regionBtns = document.querySelectorAll(".filter-btn-region");
  const activityBtns = document.querySelectorAll(".filter-btn-activity");
  const cards = document.querySelectorAll(".adventure-card");
  const noResults = document.getElementById("no-results");
  const resetBtn = document.getElementById("reset-filters");

  function updateCards() {
    let visibleCount = 0;

    cards.forEach((card) => {
      const cardRegion = card.getAttribute("data-region");
      const rawActivities = card.getAttribute("data-activities") || "";
      const cardActivities = rawActivities.split("|");

      const matchesRegion =
        activeRegion === "All" || cardRegion === activeRegion;
      const matchesActivity =
        activeActivity === "All" || cardActivities.includes(activeActivity);

      if (matchesRegion && matchesActivity) {
        card.classList.remove("hidden");
        visibleCount++;
      } else {
        card.classList.add("hidden");
      }
    });

    if (noResults) {
      noResults.classList.toggle("hidden", visibleCount > 0);
    }
  }

  function updateButtonStyles(
    buttons: NodeListOf<Element>,
    activeValue: string,
    attrName: string
  ) {
    buttons.forEach((btn) => {
      const val = btn.getAttribute(attrName);
      if (val === activeValue) {
        btn.classList.remove(
          "bg-muted",
          "text-muted-foreground",
          "hover:bg-muted/80"
        );
        btn.classList.add("bg-accent", "text-accent-foreground");
      } else {
        btn.classList.remove("bg-accent", "text-accent-foreground");
        btn.classList.add(
          "bg-muted",
          "text-muted-foreground",
          "hover:bg-muted/80"
        );
      }
    });
  }

  regionBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      activeRegion = btn.getAttribute("data-filter-region") || "All";
      updateButtonStyles(regionBtns, activeRegion, "data-filter-region");
      updateCards();
    });
  });

  activityBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      activeActivity = btn.getAttribute("data-filter-activity") || "All";
      updateButtonStyles(activityBtns, activeActivity, "data-filter-activity");
      updateCards();
    });
  });

  resetBtn?.addEventListener("click", () => {
    activeRegion = "All";
    activeActivity = "All";
    updateButtonStyles(regionBtns, "All", "data-filter-region");
    updateButtonStyles(activityBtns, "All", "data-filter-activity");
    updateCards();
  });
</script>