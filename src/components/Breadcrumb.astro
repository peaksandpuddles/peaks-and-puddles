---
import { getRelativeLocaleUrl } from "astro:i18n";
import { stripBase, stripLocale } from "@/utils/withBase";
import { useTranslations } from "@/i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const pathWithoutBase = stripBase(Astro.url.pathname).replace(/\/+$/, "");
const currentUrlPath = stripLocale(pathWithoutBase, locale);

const breadcrumbList = currentUrlPath.split("/").slice(1).filter(Boolean);

const decodeSegment = (value: string) => {
  try {
    return decodeURIComponent(value);
  } catch {
    return value;
  }
};

// Expanded dictionary map for your site's custom names & sections
const navLabels: Record<string, string> = {
  posts: t.nav.posts,
  tags: t.nav.tags,
  about: t.nav.about,
  archives: t.nav.archives,
  search: t.nav.search,
  "brands-and-shops": "Brands & Shops",
  brands: "Brands",
  shops: "Shops",
  "kit-lists": "Kit Lists",
  "gear-care": "Gear Care",
  "sport-pursuit": "SportPursuit",
  "gear-explained": "Gear Explained",
  "waterproof-ratings-explained": "Waterproof Ratings Explained",
};

// Build cumulative href paths so multi-tier links work properly (e.g. /brands-and-shops/shops)
let accumulatedPath = "";
const breadcrumbItems = breadcrumbList.map((breadcrumb) => {
  accumulatedPath += `/${breadcrumb}`;
  return {
    segment: breadcrumb,
    label: navLabels[breadcrumb] ?? decodeSegment(breadcrumb).split("-").map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(" "),
    href: getRelativeLocaleUrl(locale, accumulatedPath),
  };
});
---

<nav aria-label="Breadcrumb" class="text-muted-foreground text-sm">
  <ul class="flex flex-wrap items-center gap-2">
    <li class="flex items-center gap-2">
      <a href={getRelativeLocaleUrl(locale, "")} class="hover:text-accent hover:underline">
        {t.nav.home}
      </a>
      <span aria-hidden="true">/</span>
    </li>
    {
      breadcrumbItems.map((item, index) =>
        index + 1 === breadcrumbItems.length ? (
          <li>
            <span class="text-foreground font-medium" aria-current="page">
              {item.label}
            </span>
          </li>
        ) : (
          <li class="flex items-center gap-2">
            <a href={item.href} class="hover:text-accent hover:underline">
              {item.label}
            </a>
            <span aria-hidden="true">/</span>
          </li>
        )
      )
    }
  </ul>
</nav>