---
interface USPItem {
  text: string;
  href?: string;
}

interface Props {
  items: USPItem[];
  ticker?: boolean;
  bgColor?: string;   // Optional: Custom background color class
  textColor?: string; // Optional: Custom text color class
}

const { 
  items, 
  ticker = false, 
  bgColor = "bg-emerald-900",   // Default Ordnance Survey forest green background
  textColor = "text-emerald-50" // Default crisp light text
} = Astro.props;
---

<div class={`${bgColor} ${textColor} relative z-50 overflow-hidden py-2 text-xs font-medium sm:text-sm shadow-inner`}>
  {ticker ? (
    /* Ticker Mode: Single-track marquee for seamless freezing */
    <div class="group flex w-full overflow-hidden whitespace-nowrap">
      <div class="animate-marquee group-hover:[animation-play-state:paused] flex w-max shrink-0 items-center gap-8">
        
        {/* Original Set */}
        <div class="flex items-center gap-8 shrink-0">
          {items.map((item) => (
            <span class="inline-flex items-center gap-2">
              {item.href ? (
                <a href={item.href} class={`hover:underline flex items-center gap-1 transition-opacity hover:opacity-80 ${textColor}`}>
                  {item.text} →
                </a>
              ) : (
                <span>{item.text}</span>
              )}
            </span>
          ))}
        </div>

        {/* Exact Duplicate Set for Seamless Loop */}
        <div class="flex items-center gap-8 shrink-0" aria-hidden="true">
          {items.map((item) => (
            <span class="inline-flex items-center gap-2">
              {item.href ? (
                <a href={item.href} class={`hover:underline flex items-center gap-1 transition-opacity hover:opacity-80 ${textColor}`}>
                  {item.text} →
                </a>
              ) : (
                <span>{item.text}</span>
              )}
            </span>
          ))}
        </div>

      </div>
    </div>
  ) : (
    /* Static Centered Mode */
    <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-center gap-6 px-4 text-center">
      {items.map((item) => (
        <span class="inline-flex items-center gap-1">
          {item.href ? (
            <a href={item.href} class={`hover:underline font-semibold transition-opacity hover:opacity-80 ${textColor}`}>
              {item.text} →
            </a>
          ) : (
            <span>{item.text}</span>
          )}
        </span>
      ))}
    </div>
  )}
</div>

<style>
  @keyframes marquee {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
  .animate-marquee {
    animation: marquee 30s linear infinite;
  }
</style>